{
  "name": "clubos-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "npm run test:subscription-truth && npm run test:permission-boundary && prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "cap:sync": "node scripts/native-shell-config.mjs && cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "cap:dev:sim": "node scripts/native-dev-switch.mjs sim",
    "cap:dev:iphone": "node scripts/native-dev-switch.mjs iphone",
    "cap:dev:prod": "node scripts/native-dev-switch.mjs prod",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "verify:family-access": "tsx scripts/verify-family-access.ts",
    "test:family": "tsx scripts/family-accounts-tests.ts",
    "test:family-fixtures": "tsx scripts/family-fixtures-tests.ts",
    "test:phase4": "npm run test:family && npm run test:family-fixtures",
    "test:member-tracks": "tsx scripts/member-tracks-tests.ts",
    "test:renewal-surfacing": "tsx scripts/renewal-surfacing-tests.ts",
    "test:membership-options": "tsx scripts/membership-options-tests.ts",
    "test:entitlements": "tsx scripts/entitlements-tests.ts",
    "test:members-guards": "tsx scripts/members-grep-guards.ts",
    "test:subscription-truth": "tsx scripts/subscription-truth-guard.ts",
    "test:non-renewal": "tsx scripts/non-renewal-tests.ts",
    "test:permission-boundary": "tsx scripts/permission-boundary-guard.ts",
    "test:permission-behaviour": "tsx scripts/permission-behaviour-tests.ts",
    "test:phase6": "npm run test:subscription-truth && npm run test:permission-boundary && npm run test:permission-behaviour && npm run test:non-renewal",
    "report:subscription-truth": "tsx scripts/report-subscription-truth.ts",
    "test:sport-terms": "tsx scripts/sport-terms-guard.ts",
    "test:phase45": "npm run test:member-tracks && npm run test:member-ui && npm run test:members-guards",
    "test:phase5": "tsx scripts/event-confirmation-state-tests.ts && tsx scripts/event-payment-tests.ts && tsx scripts/event-repricing-tests.ts && npm run test:sport-terms",
    "test:member-ui": "tsx --tsconfig scripts/tsconfig.render.json scripts/member-ui-tests.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^1.0.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@prisma/client": "5.7.0",
    "@sentry/nextjs": "^10.54.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@types/nodemailer": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "isomorphic-dompurify": "^2.36.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.469.0",
    "mjml": "^5.4.0",
    "next": "14.2.35",
    "next-auth": "^4.24.7",
    "nodemailer": "^7.0.13",
    "plaid": "^42.2.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-plaid-link": "^4.1.1",
    "resend": "^6.18.1",
    "stripe": "^14.21.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mjml": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.15",
    "playwright": "^1.49.1",
    "postcss": "^8.4.0",
    "prisma": "5.7.0",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
